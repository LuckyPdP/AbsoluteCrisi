          m_BoolArgument: 0
        m_CallState: 2
  retratoIzquierda: {fileID: 3208565416372445753}
  retratoDerecha: {fileID: 7615915364678234625}
  DialogueText: {fileID: 7656910221450627332}
  panelBotones: {fileID: 1877097185121955021}
  botonesUI:
  - {fileID: 3780324082683762214}
  - {fileID: 855226745871133360}
  conversacion:
  - texto: "JOTA:\n\u2014 Pens\xE9 que te obligar\xEDan a descansar m\xE1s."
    retrato: {fileID: 21300000, guid: 930bc8ead292ae144936dbff3badfb7b, type: 3}
    lado: 1
    opciones: []
  - texto: "EITHAN:\n\u2014 Ya tuve suficiente."
    retrato: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e, type: 3}
    lado: 0
    opciones: []
  - texto: '(Jota me sostiene la mirada.)

'
    retrato: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e, type: 3}
    lado: 1
    opciones: []
  - texto: "JOTA:\n\u2014 No respirabas cuando te trajeron."
    retrato: {fileID: 21300000, guid: 930bc8ead292ae144936dbff3badfb7b, type: 3}
    lado: 0
    opciones: []
  - texto: '(Me acerco al traje)

'
    retrato: {fileID: 21300000, guid: 930bc8ead292ae144936dbff3badfb7b, type: 3}
    lado: 1
    opciones: []
  - texto: "EITHAN:\n\u2014 Esto no es lo que dise\xF1\xE9."
    retrato: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e, type: 3}
    lado: 0
    opciones: []
  - texto: "JOTA:\n\u2014 Es lo que pude salvar.\n\n"
    retrato: {fileID: 21300000, guid: 87fee339ce00f354c97b30858533b305, type: 3}
    lado: 1
    opciones: []
  - texto: "(Recorre con delicadeza la m\xE1scara del traje.)"
    retrato: {fileID: 21300000, guid: 87fee339ce00f354c97b30858533b305, type: 3}
    lado: 0
    opciones: []
  - texto: "EITHAN:\n\u2014 Falta el m\xF3dulo de presi\xF3n.\n"
    retrato: {fileID: 21300000, guid: 1321eb71d67790c409243ecdf81c81ac, type: 3}
    lado: 1
    opciones: []
  - texto: "JOTA:\n\u2014 Se quem\xF3. El n\xFAcleo colaps\xF3.\n"
    retrato: {fileID: 21300000, guid: 87fee339ce00f354c97b30858533b305, type: 3}
    lado: 1
    opciones: []
  - texto: "EITHAN:\n...\n\u2014 \xBFQu\xE9 est\xE1 fallando ahora?"
    retrato: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e, type: 3}
    lado: 0
    opciones: []
  - texto: "JOTA:\n\u2014 A los ocho minutos la presi\xF3n se dispara. El filtro
      no aguanta y el sellado\u2026 es inestable."
    retrato: {fileID: 21300000, guid: fdd93f31830cf4d468c36506f61dc2a7, type: 3}
    lado: 1
    opciones: []
  - texto: '(Asiento apenas con la cabeza)

'
    retrato: {fileID: 21300000, guid: fdd93f31830cf4d468c36506f61dc2a7, type: 3}
    lado: 0
    opciones: []
  - texto: "EITHAN:\n\u2014 Lo arreglar\xE9."
    retrato: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e, type: 3}
    lado: 0
    opciones: []
  - texto: '(Jota me mira mientras le da una calada a su cigarrillo)

'
    retrato: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e, type: 3}
    lado: 1
    opciones: []
  - texto: "JOTA:\n\u2014 M\xE1s vale."
    retrato: {fileID: 21300000, guid: 11b45789f0289ed4980c49ad82422300, type: 3}
    lado: 1
    opciones: []
  panelDialogo: {fileID: 4505558943343153076}
  dialogueSpeed: 0.005
