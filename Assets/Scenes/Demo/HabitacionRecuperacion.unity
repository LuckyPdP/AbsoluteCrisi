      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[4].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[6].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[8].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[9].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[0].texto
      value: "ERIS:\n\u2014 Est\xE1s consciente... bien\u2026 \xBFC\xF3mo te encuentras?"
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[11].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[14].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[15].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[16].lado
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[1].texto
      value: "EITHAN:\n\u2014 Quisiera estar mejor\u2026. \xBFCu\xE1nto llevo despierto?"
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[2].texto
      value: "ERIS:\n\u2014 Desde el accidente llevas tres d\xEDas inconsciente y
        una semana recuper\xE1ndote."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[3].texto
      value: "EITHAN:\n\u2014 No recuerdo el accidente."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[4].texto
      value: "ERIS:\n\u2014 Eso es muy com\xFAn en personas con conmociones severas."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[5].texto
      value: "EITHAN:\n\u2014 \xBFFue en el laboratorio?"
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[6].texto
      value: "ERIS:\n\u2014 S\xED.."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[7].texto
      value: "EITHAN:\n\u2014 \xBFQu\xE9 paso? \xBFEl traje explot\xF3?"
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[8].texto
      value: "ERIS:\n\u2014 Algo as\xED... Hubo un fallo en el sistema del traje
        que provoc\xF3 un corto circuito, tu estabas m\xE1s cerca y... te alcanz\xF3
        y te desmallaste. Ya llevamos a\xF1os con esto y a estas alturas solo me
        queda cancelar el proyecto\u2026 pero..."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[9].texto
      value: "ERIS:\n\u2014 Jota movi\xF3 el prototipo al M\xF3dulo T\xE9cnico y
        ha estado intentando mantenerlo operativo."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[10].texto
      value: "EITHAN:\n \u2014 Quiero verlo."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[11].texto
      value: "ERIS:\n\u2014 No tienes que precipitarte. Nadie espera que lo soluciones
        todo en un d\xEDa."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[12].texto
      value: "EITHAN:\n\u2014 No lo hago por ellos."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[13].texto
      value: "(Eris suspira mientras me entrega una bolsa con mi ropa y una nueva
        acreditaci\xF3n.)"
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[14].texto
      value: "ERIS:\n\u2014 Tu acceso fue reiniciado. Para llegar al m\xF3dulo, tienes
        que cruzar el N\xFAcleo Central."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[15].texto
      value: '(Antes de retirarse, se detiene, volteando a verme) '
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[16].texto
      value: "ERIS:\n\u2014 Si sientes mareos\u2026 ve a mi oficina."
      objectReference: {fileID: 0}
    - target: {fileID: 8785693979804358267, guid: 22188650093959a48ba7f90edb09c088,
        type: 3}
      propertyPath: conversacion.Array.data[1].retrato
      value: 
      objectReference: {fileID: 21300000, guid: 983b917c8d931ec41a6bdecaa2ff1f6e,
